{
  "name": "hwagae-jangnal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @hwagae/web",
    "dev:api": "uv run uvicorn app.main:app --app-dir apps/api --reload --reload-dir apps/api --host 127.0.0.1 --port 8000 --env-file apps/api/.env",
    "build": "npm run build --workspace @hwagae/web",
    "check": "npm run typecheck --workspace @hwagae/web",
    "test:api": "uv run pytest"
  }
}
