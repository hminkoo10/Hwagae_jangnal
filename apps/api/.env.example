CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Local demo accounts. Change before any public deployment.
SEED_DEMO=true
APP_ENV=development
DEMO_PASSWORD=hwagae-demo
# DB_PATH=C:/absolute/path/hwagae.sqlite3
# Optional live merchant provider; the Walmart persistence model is replay-only.
# FORECAST_PROVIDER=your_live_provider:predict
# Explicit historical Walmart sample only. Other stores retain their provider.
TFT_DEMO_ENABLED=false
# Isolated Python 3.11 model interpreter; the API remains Python 3.14.
# TFT_PYTHON=/absolute/path/to/model-env/bin/python
# TFT_CHECKPOINT_PATH=/absolute/path/to/best-epoch=02-val_loss=3.9847.ckpt
# TFT_NUM_THREADS=1
# Demo uses the existing local demo-owner account and cutoff 2014-09-12.
# Coordinates, prices and inventory are unavailable; ordering is disabled.
