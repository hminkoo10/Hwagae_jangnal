CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Local demo accounts. Change before any public deployment.
SEED_DEMO=true
APP_ENV=development
DEMO_PASSWORD=hwagae-demo
# DB_PATH=C:/absolute/path/hwagae.sqlite3
# Select weekday or merchant TFT per store in the web model settings.
# Both TFT models use separate Python 3.11 processes, not the API environment.
# The merchant model uses the bundled ml/merchant_tft/model.ckpt.
# TFT_PYTHON=C:/absolute/path/Hwagae_jangnal/.model-venv/Scripts/python.exe
# TFT_CHECKPOINT_PATH=C:/models/best-epoch=02-val_loss=3.9847.ckpt
# Owner AI API keys are encrypted in SQLite; keep this master-key file with DB backups.
# Defaults to ai-master.key beside DB_PATH. Never place it inside a release directory.
# AI_SECRET_KEY_PATH=C:/absolute/persistent/path/ai-master.key
